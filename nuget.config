<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Use only the public NuGet feed for this demo repo, ignoring any
       machine-level private feeds (e.g. corporate Azure DevOps) that would
       otherwise stall restore waiting on authentication. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
