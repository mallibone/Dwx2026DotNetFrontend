<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PrTracker.Maui.Views.RecordEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PrTracker.Maui.ViewModels"
    x:DataType="vm:RecordEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Exercise" />
            <Entry Text="{Binding Exercise}" Placeholder="e.g. Back Squat" />

            <Label Text="Weight (kg)" />
            <Entry Text="{Binding WeightKg}" Keyboard="Numeric" />

            <Label Text="Reps" />
            <Entry Text="{Binding Reps}" Keyboard="Numeric" />

            <Label Text="Date" />
            <DatePicker Date="{Binding Date}" />

            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
